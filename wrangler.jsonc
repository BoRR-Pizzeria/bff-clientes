{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bffborr",
  // Fecha de compatibilidad reciente (revisar contra
  // https://developers.cloudflare.com/workers/configuration/compatibility-dates/)
  "compatibility_date": "2026-06-01",
  // supabase-js usa APIs de Node (stream/crypto) en algunos paths.
  "compatibility_flags": ["nodejs_compat"],
  // El adapter @astrojs/cloudflare emite el build a ./dist para Pages.
  "pages_build_output_dir": "./dist",
  // Variables NO secretas. En producción se setean en el dashboard de Pages;
  // estas son los defaults de dev sobre la malla ZeroTier.
  // FRONT_ORIGIN = origen del front (FFBORR) para CORS.
  "vars": {
    "FRONT_ORIGIN": "http://10.144.0.3:4321"
  }
}
