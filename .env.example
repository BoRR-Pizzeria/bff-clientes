# Copiar a `.env` (vars PUBLIC_ que Astro inlinea en build/dev) y, para el runtime
# de Cloudflare en dev, a `.dev.vars`. En producción se setean en Pages → Settings → Env.

# Proyecto Supabase (BSBORR). La anon key es pública por diseño (la seguridad vive en RLS).
PUBLIC_SUPABASE_URL=https://rikafvgarvjhnbkauxzi.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.example

# Origen permitido para CORS = el front (FFBORR). En dev suele ser el dev server de Astro.
# Se lee del runtime de Cloudflare (wrangler vars / Pages env), no de import.meta.env.
FRONT_ORIGIN=http://localhost:4321
