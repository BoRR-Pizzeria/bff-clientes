            "description": "shop_id es un uuid de la tabla shops en Supabase; este BFF no tiene endpoint para listarlas, completa {{shopId}} a mano (p.ej. consultando la DB o el REST de Supabase directo)."
          }
        }
      ]
    },
    {
      "name": "CORS",
      "item": [
        {
          "name": "OPTIONS preflight /api/health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "{{frontOrigin}}" },
              { "key": "Access-Control-Request-Method", "value": "GET" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Debe devolver 204 con Access-Control-Allow-Origin: {{frontOrigin}}."
          }
        }
      ]
    }
